{
  "name": "@craft-ai/react",
  "version": "1.0.0",
  "description": "React components for CRAFT - Chatbot & RAG Framework Toolkit",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:demo": "tsc && vite build -c vite.demo.config.ts",
    "preview": "vite preview",
    "preview:demo": "vite preview --outDir dist-demo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "craft",
    "chatbot",
    "react",
    "chat",
    "ai",
    "llm",
    "rag",
    "anthropic",
    "openai"
  ],
  "author": "CRAFT Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/StefanoHernandez/CRAFT.git",
    "directory": "craft-react"
  },
  "homepage": "https://github.com/StefanoHernandez/CRAFT#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.0.4",
    "@types/three": "^0.181.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.555.0",
    "maath": "^0.10.8",
    "postprocessing": "^6.38.0",
    "react-hook-form": "^7.66.1",
    "reactflow": "^11.11.4",
    "three": "^0.181.2",
    "zod": "^4.1.13",
    "zustand": "^5.0.8"
  }
}
